# Durlevel site — Nginx reverse proxy.
# Installed to /etc/nginx/sites-available/durlevel by deploy/install.sh, which
# substitutes __DOMAIN__, __PORT__ and __APP_DIR__.
#
# certbot adds the TLS server block and the HTTP redirect when it runs, so this
# file deliberately starts as plain HTTP on port 80.

server {
    listen 80;
    listen [::]:80;
    server_name __DOMAIN__;

    # Must exceed MAX_UPLOAD_MB / MAX_DOC_MB in .env, or large uploads are cut
    # off by Nginx before the app ever sees them.
    client_max_body_size 25m;

    # The site is private and sent to named customers; keep it out of indexes
    # even if a crawler somehow reaches it.
    add_header X-Robots-Tag "noindex, nofollow" always;

    access_log /var/log/nginx/durlevel.access.log;
    error_log  /var/log/nginx/durlevel.error.log;

    # NOTE: there is deliberately no `location /uploads/` block here any more.
    # Product images are private catalogue content, so they are served by the
    # app behind a login check. Serving them off disk here would bypass that
    # guard entirely. If you are upgrading an install that still has the old
    # block, delete it and reload Nginx — otherwise the fix does nothing.

    location / {
        proxy_pass http://127.0.0.1:__PORT__;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        # TRUST_PROXY=1 in .env makes the app read the client IP from here.
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection        "";
        proxy_read_timeout 60s;
    }
}
