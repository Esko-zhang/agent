<%- include('_shell-top', { heading: '概览' }) %>

<div class="admin-head">
  <h1>概览</h1>
</div>

<% if (flash) { %><p class="alert alert-ok"><%= flash %></p><% } %>

<div class="stat-grid">
  <% if (roles.canSee(currentUser, 'products')) { %>
    <div class="stat">
      <div class="n"><%= totalProducts %></div>
      <div class="k">产品总数</div>
    </div>
    <% categories.forEach(function (c) { %>
      <div class="stat">
        <div class="n"><%= counts[c.key] || 0 %></div>
        <div class="k"><%= c.zh %></div>
      </div>
    <% }); %>
  <% } %>
  <% if (roles.canSee(currentUser, 'staff')) { %>
    <div class="stat">
      <div class="n"><%= staffCount %></div>
      <div class="k">业务员名片</div>
    </div>
  <% } %>
  <div class="stat">
    <div class="n"><%= users.length %></div>
    <div class="k"><%= roles.isAdmin(currentUser) ? '登录账号' : '我的用户账号' %></div>
  </div>
  <% if (roles.canSee(currentUser, 'inquiries')) { %>
    <div class="stat">
      <div class="n"><%= newInquiries %></div>
      <div class="k">待处理询盘</div>
    </div>
  <% } %>
  <% if (roles.isAdmin(currentUser) && inactiveProducts) { %>
    <div class="stat">
      <div class="n"><%= inactiveProducts %></div>
      <div class="k">下架中的产品<% if (pendingProducts) { %>（<%= pendingProducts %> 个待审核）<% } %></div>
    </div>
  <% } %>
</div>

<div class="card">
  <h2>快捷操作</h2>
  <div class="admin-head actions">
    <% if (roles.canSee(currentUser, 'products')) { %>
      <a class="btn" href="/admin/products/new">新增产品</a>
    <% } %>
    <% if (roles.canSee(currentUser, 'staff')) { %>
      <a class="btn btn-ghost" href="/admin/staff/new">新增业务员名片</a>
    <% } %>
    <% if (roles.canSee(currentUser, 'users')) { %>
      <a class="btn <%= roles.canSee(currentUser, 'products') ? 'btn-ghost' : '' %>" href="/admin/users">创建登录账号</a>
    <% } %>
    <% if (roles.canSee(currentUser, 'inquiries')) { %>
      <a class="btn btn-ghost" href="/admin/inquiries">查看询盘</a>
    <% } %>
    <% if (roles.canSee(currentUser, 'settings')) { %>
      <a class="btn btn-ghost" href="/admin/settings">修改 Logo / 站点文案</a>
    <% } %>
    <% if (roles.canSee(currentUser, 'logs')) { %>
      <a class="btn btn-ghost" href="/admin/logs">查看访问记录</a>
    <% } %>
  </div>
</div>

<div class="card">
  <h2>
    账号一览
    <span class="hint">
      <% if (roles.isAdmin(currentUser)) { %>
        管理员可创建业务员和用户账号；业务员可创建用户账号。前台不提供注册入口。
      <% } else { %>
        这里显示你可以管理的用户账号。前台不提供注册入口。
      <% } %>
    </span>
  </h2>
  <div class="table-wrap">
    <table class="data">
      <thead>
        <tr><th>账号</th><th>姓名</th><th>角色</th><th>状态</th><th>最近登录</th></tr>
      </thead>
      <tbody>
        <% users.forEach(function (u) { %>
          <tr>
            <td><%= u.username %></td>
            <td><%= u.display_name || '—' %></td>
            <td>
              <span class="badge badge-role-<%= u.role %>"><%= roles.ROLE_LABELS[u.role] %></span>
            </td>
            <td>
              <% if (u.is_active) { %><span class="badge badge-on">启用</span>
              <% } else { %><span class="badge badge-off">停用</span><% } %>
            </td>
            <td><%= u.last_login_at || '从未登录' %></td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
</div>

<%- include('_shell-bottom') %>
