<%- include('_shell-top', { heading: '账号管理' }) %>

<div class="admin-head">
  <h1>账号管理</h1>
</div>

<% if (flash) { %><p class="alert alert-ok"><%= flash %></p><% } %>
<% if (error) { %><p class="alert alert-error"><%= error %></p><% } %>

<p class="admin-hint">
  <% if (canAssignRoles) { %>
    管理员可以创建<strong>业务员</strong>和<strong>用户</strong>账号；业务员只能创建<strong>用户</strong>账号。
  <% } else { %>
    你是<strong>业务员</strong>账号，可以创建和管理<strong>用户</strong>账号。
    业务员和管理员账号由管理员负责，这里不会显示。
  <% } %>
  网站前台没有注册入口，账号只能在这里发放。
</p>

<div class="card">
  <h2>新建账号</h2>
  <form method="post" action="/admin/users">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="form-grid">
      <label class="field">
        <span>登录账号 *<span class="hint">（3-32 位字母、数字或 . _ @ -）</span></span>
        <input name="username" required maxlength="32" pattern="[A-Za-z0-9._@\-]{3,32}"
               autocapitalize="none" spellcheck="false">
      </label>
      <label class="field">
        <span>登录密码 *<span class="hint">（至少 8 位）</span></span>
        <input name="password" type="password" required minlength="8" autocomplete="new-password">
      </label>
      <label class="field">
        <span>姓名 / 客户名称</span>
        <input name="display_name" maxlength="100">
      </label>
      <label class="field">
        <span>角色</span>
        <% if (assignable.length > 1) { %>
          <select name="role">
            <% allRoles.forEach(function (r) { %>
              <% if (assignable.indexOf(r.key) !== -1) { %>
                <option value="<%= r.key %>" <%= r.key === 'user' ? 'selected' : '' %>>
                  <%= r.zh %> —— <%= r.hint %>
                </option>
              <% } %>
            <% }); %>
          </select>
        <% } else { %>
          <input value="用户（仅浏览前台）" readonly>
          <input type="hidden" name="role" value="<%= assignable[0] %>">
        <% } %>
      </label>
    </div>
    <label class="check-row">
      <input type="checkbox" name="is_active" value="1" checked>
      <span>启用该账号</span>
    </label>
    <div class="form-actions">
      <button class="btn" type="submit">创建账号</button>
    </div>
  </form>
</div>

<div class="card">
  <h2><%= canAssignRoles ? '现有账号' : '我可以管理的用户账号' %>（<%= rows.length %>）</h2>
  <div class="table-wrap">
    <table class="data">
      <thead>
        <tr>
          <th>账号</th><th>姓名</th><th>角色 / 状态</th>
          <th>最近登录</th><th>重置密码</th><th>操作</th>
        </tr>
      </thead>
      <tbody>
        <% if (!rows.length) { %>
          <tr><td colspan="6" class="empty-row">还没有可管理的账号。</td></tr>
        <% } %>
        <% rows.forEach(function (u) { %>
          <tr>
            <td>
              <strong><%= u.username %></strong>
              <% if (u.id === currentUser.id) { %><span class="badge badge-admin">当前登录</span><% } %>
            </td>
            <td>
              <form method="post" action="/admin/users/<%= u.id %>" id="u-<%= u.id %>">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <input name="display_name" value="<%= u.display_name || '' %>" maxlength="100">
              </form>
            </td>
            <td>
              <% if (canAssignRoles) { %>
                <select name="role" form="u-<%= u.id %>">
                  <% allRoles.forEach(function (r) { %>
                    <option value="<%= r.key %>" <%= u.role === r.key ? 'selected' : '' %>><%= r.zh %></option>
                  <% }); %>
                </select>
              <% } else { %>
                <span class="badge badge-role-<%= u.role %>"><%= roleLabels[u.role] %></span>
              <% } %>
              <label class="check-row">
                <input type="checkbox" name="is_active" value="1" form="u-<%= u.id %>"
                       <%= u.is_active ? 'checked' : '' %>>
                <span>启用</span>
              </label>
              <button class="btn btn-ghost btn-sm" type="submit" form="u-<%= u.id %>">保存</button>
            </td>
            <td><%= u.last_login_at || '从未登录' %></td>
            <td>
              <form method="post" action="/admin/users/<%= u.id %>/password">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <div class="row-actions">
                  <input name="password" type="password" minlength="8" required
                         placeholder="新密码（≥8 位）" autocomplete="new-password">
                  <button class="btn btn-ghost btn-sm" type="submit">重置</button>
                </div>
              </form>
            </td>
            <td>
              <% if (u.id === currentUser.id) { %>
                <span class="hint">—</span>
              <% } else { %>
                <form method="post" action="/admin/users/<%= u.id %>/delete"
                      data-confirm="确定删除账号「<%= u.username %>」？该账号将无法再登录。">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <button class="btn btn-danger btn-sm" type="submit">删除</button>
                </form>
              <% } %>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
</div>

<%- include('_shell-bottom') %>
