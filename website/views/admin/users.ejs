<%- include('_shell-top', { heading: '账号管理' }) %>

<%
// Keeps what was typed when a validation error sends the form back.
var d = typeof draft === 'object' && draft ? draft : {};
function keep(name) { return d[name] == null ? '' : String(d[name]); }
%>

<%# One list for every country field on the page: the row blocks reference it
    by id rather than repeating 249 options each. %>
<datalist id="country-list">
  <% countryOptions.forEach(function (c) { %>
    <option value="<%= c.name %>"><%= c.flag %> <%= c.code %></option>
  <% }); %>
</datalist>

<div class="admin-head">
  <h1>账号管理</h1>
</div>

<% if (flash) { %><p class="alert alert-ok"><%= flash %></p><% } %>
<% if (error) { %><p class="alert alert-error"><%= error %></p><% } %>

<p class="admin-hint">
  <% if (canAssignRoles) { %>
    管理员可以创建<strong>业务员</strong>和<strong>用户</strong>账号；业务员只能创建<strong>用户</strong>账号。
  <% } else { %>
    你是<strong>业务员</strong>账号，可以创建用户账号。
    这里只显示<strong>你自己创建的客户</strong>——其他业务员的客户、以及管理员和业务员账号都不会出现。
  <% } %>
  网站前台没有注册入口，账号只能在这里发放。
  <strong>每个用户账号会记录是谁创建的</strong>——该客户打开询盘页时，会看到创建他账号的那位业务员的 WhatsApp 按钮。
</p>

<div class="card">
  <h2>新建账号</h2>
  <form method="post" action="/admin/users">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="form-grid">
      <label class="field">
        <span>登录账号 *<span class="hint">（3-32 位字母、数字或 . _ @ -）</span></span>
        <input name="username" required maxlength="32" pattern="[A-Za-z0-9._@\-]{3,32}"
               autocapitalize="none" spellcheck="false" value="<%= keep('username') %>">
      </label>
      <label class="field">
        <span>登录密码 *<span class="hint">（至少 8 位）</span></span>
        <input name="password" type="password" required minlength="8" autocomplete="new-password">
      </label>
      <label class="field">
        <span>姓名 / 客户名称</span>
        <input name="display_name" maxlength="100" value="<%= keep('display_name') %>">
      </label>
      <label class="field">
        <span>角色</span>
        <% if (assignable.length > 1) { %>
          <select name="role">
            <% allRoles.forEach(function (r) { %>
              <% if (assignable.indexOf(r.key) !== -1) { %>
                <option value="<%= r.key %>" <%= r.key === 'user' ? 'selected' : '' %>>
                  <%= r.zh %> —— <%= r.hint %>
                </option>
              <% } %>
            <% }); %>
          </select>
        <% } else { %>
          <input value="用户（仅浏览前台）" readonly>
          <input type="hidden" name="role" value="<%= assignable[0] %>">
        <% } %>
      </label>
    </div>
    <% if (canAssignRoles) { %>
      <label class="field">
        <span>关联「业务员名片」
          <span class="hint">（创建业务员账号时选；客户的询盘页会显示这张名片的 WhatsApp）</span>
        </span>
        <select name="staff_id">
          <option value="">不关联</option>
          <% cards.forEach(function (c) { %>
            <option value="<%= c.id %>">
              <%= c.name %><%= c.whatsapp ? '（' + c.whatsapp + '）' : '（未填 WhatsApp）' %>
            </option>
          <% }); %>
        </select>
      </label>
    <% } %>
    <fieldset class="contact-set">
      <legend>联系方式
        <span class="hint">（选填，可随时补填；管理员在「联系方式汇总」里能看到全部账号的汇总）</span>
      </legend>
      <div class="form-grid">
        <label class="field">
          <span>公司</span>
          <input name="company" maxlength="120" value="<%= keep('company') %>">
        </label>
        <label class="field">
          <span>邮箱</span>
          <input name="email" type="email" maxlength="160" autocapitalize="none"
                 spellcheck="false" value="<%= keep('email') %>">
        </label>
        <label class="field">
          <span>电话 <span class="hint">（建议带国际区号，如 +880 …）</span></span>
          <input name="phone" maxlength="40" value="<%= keep('phone') %>">
        </label>
        <label class="field">
          <span>WhatsApp <span class="hint">（号码，汇总页会生成聊天链接）</span></span>
          <input name="whatsapp" maxlength="40" value="<%= keep('whatsapp') %>">
        </label>
        <label class="field">
          <span>国家 / 地区 <span class="hint">（输入即有建议，也可填 US、BD 这样的代码）</span></span>
          <input name="country" list="country-list" maxlength="64" value="<%= keep('country') %>">
        </label>
      </div>
    </fieldset>
    <label class="check-row">
      <input type="checkbox" name="is_active" value="1" checked>
      <span>启用该账号</span>
    </label>
    <div class="form-actions">
      <button class="btn" type="submit">创建账号</button>
    </div>
  </form>
</div>

<div class="card">
  <h2><%= canAssignRoles ? '现有账号' : '我的客户账号' %>（<%= rows.length %>）</h2>
  <div class="table-wrap">
    <table class="data">
      <thead>
        <tr>
          <th>账号</th><th>姓名</th><th>角色 / 状态</th><th>联系方式</th>
          <th>创建人</th><th>最近登录</th><th>重置密码</th><th>操作</th>
        </tr>
      </thead>
      <tbody>
        <% if (!rows.length) { %>
          <tr><td colspan="8" class="empty-row">还没有可管理的账号。</td></tr>
        <% } %>
        <% rows.forEach(function (u) { %>
          <tr>
            <td>
              <strong><%= u.username %></strong>
              <% if (u.id === currentUser.id) { %><span class="badge badge-admin">当前登录</span><% } %>
            </td>
            <td>
              <form method="post" action="/admin/users/<%= u.id %>" id="u-<%= u.id %>">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <input name="display_name" value="<%= u.display_name || '' %>" maxlength="100">
              </form>
            </td>
            <td>
              <% if (canAssignRoles) { %>
                <select name="role" form="u-<%= u.id %>">
                  <% allRoles.forEach(function (r) { %>
                    <option value="<%= r.key %>" <%= u.role === r.key ? 'selected' : '' %>><%= r.zh %></option>
                  <% }); %>
                </select>
              <% } else { %>
                <span class="badge badge-role-<%= u.role %>"><%= roleLabels[u.role] %></span>
              <% } %>
              <% if (canAssignRoles && u.role === 'sales') { %>
                <select name="staff_id" form="u-<%= u.id %>">
                  <option value="">不关联名片</option>
                  <% cards.forEach(function (c) { %>
                    <option value="<%= c.id %>" <%= u.staff_id === c.id ? 'selected' : '' %>><%= c.name %></option>
                  <% }); %>
                </select>
              <% } %>
              <label class="check-row">
                <input type="checkbox" name="is_active" value="1" form="u-<%= u.id %>"
                       <%= u.is_active ? 'checked' : '' %>>
                <span>启用</span>
              </label>
              <button class="btn btn-ghost btn-sm" type="submit" form="u-<%= u.id %>">保存</button>
            </td>
            <td class="contact-grid">
              <div class="contact-sum">
                <span class="<%= u.email ? 'ok' : '' %>">邮箱<%= u.email ? '✓' : '—' %></span>
                <span class="<%= u.phone ? 'ok' : '' %>">电话<%= u.phone ? '✓' : '—' %></span>
                <span class="<%= u.whatsapp ? 'ok' : '' %>">WhatsApp<%= u.whatsapp ? '✓' : '—' %></span>
                <span class="<%= u.country ? 'ok' : '' %>">国家<%= u.country ? '✓' : '—' %></span>
              </div>
              <details class="contact-edit">
                <summary>填写 / 修改</summary>
                <label class="field">
                  <span>公司</span>
                  <input name="company" form="u-<%= u.id %>" maxlength="120"
                         value="<%= u.company || '' %>">
                </label>
                <label class="field">
                  <span>邮箱</span>
                  <input name="email" type="email" form="u-<%= u.id %>" maxlength="160"
                         autocapitalize="none" spellcheck="false" value="<%= u.email || '' %>">
                </label>
                <label class="field">
                  <span>电话</span>
                  <input name="phone" form="u-<%= u.id %>" maxlength="40" value="<%= u.phone || '' %>">
                </label>
                <label class="field">
                  <span>WhatsApp</span>
                  <input name="whatsapp" form="u-<%= u.id %>" maxlength="40"
                         value="<%= u.whatsapp || '' %>">
                </label>
                <label class="field">
                  <span>国家 / 地区</span>
                  <input name="country" form="u-<%= u.id %>" list="country-list" maxlength="64"
                         value="<%= countryNameOf(u.country) %>">
                </label>
                <p class="hint">改完点这一行的「保存」。</p>
              </details>
            </td>
            <td>
              <% if (u.created_by_name) { %>
                <%= u.created_by_name %>
              <% } else { %>
                <span class="hint">—</span>
              <% } %>
            </td>
            <td><%= u.last_login_at || '从未登录' %></td>
            <td>
              <form method="post" action="/admin/users/<%= u.id %>/password">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <div class="row-actions">
                  <input name="password" type="password" minlength="8" required
                         placeholder="新密码（≥8 位）" autocomplete="new-password">
                  <button class="btn btn-ghost btn-sm" type="submit">重置</button>
                </div>
              </form>
            </td>
            <td>
              <% if (u.id === currentUser.id) { %>
                <span class="hint">—</span>
              <% } else { %>
                <form method="post" action="/admin/users/<%= u.id %>/delete"
                      data-confirm="确定删除账号「<%= u.username %>」？该账号将无法再登录。">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <button class="btn btn-danger btn-sm" type="submit">删除</button>
                </form>
              <% } %>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
</div>

<%- include('_shell-bottom') %>
