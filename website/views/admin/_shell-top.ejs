<%- include('../partials/head', { pageTitle: '管理后台 — ' + heading, lang: 'zh-CN', adminCss: true }) %>
<body class="admin-body">
  <div class="admin-shell">
    <aside class="admin-side">
      <div class="side-brand">
        <%= settings.brand_name %>
        <small>Admin Console</small>
      </div>
      <%# The wrapper exists only so the fade marking "this strip scrolls" can
          sit above the scroller on a narrow screen. %>
      <div class="admin-nav-scroll">
      <nav>
        <% visibleSections.forEach(function (sec) { %>
          <a href="<%= sec.path %>" class="<%= nav === sec.key ? 'active' : '' %>">
            <%= sec.zh %><% if (sec.key === 'inquiries' && newInquiries) { %><span class="side-badge"><%= newInquiries %></span><% } %><% if (sec.key === 'products' && pendingProducts) { %><span class="side-badge" title="业务员录入、等待上架"><%= pendingProducts %></span><% } %>
          </a>
        <% }); %>
      </nav>
      </div>
      <div class="side-foot">
        <div>
          <%= currentUser.display_name || currentUser.username %>
          <span class="side-role"><%= roles.ROLE_LABELS[currentUser.role] %></span>
        </div>
        <a href="/products">← 返回前台</a>
        <form method="post" action="/logout">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button type="submit">退出登录</button>
        </form>
      </div>
    </aside>
    <main class="admin-main">
