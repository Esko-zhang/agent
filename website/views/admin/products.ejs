<%- include('_shell-top', { heading: '产品管理' }) %>

<div class="admin-head">
  <h1>产品管理</h1>
  <div class="spacer"></div>
  <div class="actions">
    <% if (canImport) { %>
      <form class="inline-form" method="post" action="/admin/products/renumber"
            data-confirm="把<%= category ? '当前分类' : '全部分类' %>的排序值按现在的顺序重排成 1、2、3…？顺序本身不变<%= search ? '；搜索条件不影响它，整个分类都会重排' : '' %>。">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="hidden" name="category" value="<%= category || '' %>">
        <button class="btn btn-ghost" type="submit">重新编号</button>
      </form>
      <a class="btn btn-ghost" href="/admin/products/import">批量导入</a>
      <%# 导出跟着当前的分类和搜索条件走，所以导出的就是眼前这一批。 %>
      <a class="btn btn-ghost"
         href="/admin/products/export.xlsx<%= category || search ? '?' : '' %><%=
           category ? 'category=' + category : '' %><%=
           category && search ? '&' : '' %><%=
           search ? 'q=' + encodeURIComponent(search) : '' %>">批量导出</a>
    <% } %>
    <a class="btn" href="/admin/products/new<%= category ? '?category=' + category : '' %>">+ 新增产品</a>
  </div>
</div>

<% if (flash) { %><p class="alert alert-ok"><%= flash %></p><% } %>

<% if (!canPublish) { %>
  <p class="admin-hint">
    你可以<strong>新增和修改产品</strong>。新增的产品保存后是<strong>下架</strong>状态，
    <strong>等管理员上架后客户才看得到</strong>；上下架和删除由管理员操作。
    每次改动都会记进「产品变更记录」。
  </p>
<% } else if (typeof pendingProducts !== 'undefined' && pendingProducts) { %>
  <p class="admin-hint">
    有 <strong><%= pendingProducts %></strong> 个业务员录入的产品还没上架。
    在下方列表里打开它，确认无误后勾选「上架」保存即可。
  </p>
<% } %>

<%# The tabs carry the search term, so switching category keeps what you
    typed — and the 全部 tab is the one click that widens a search that came
    up short inside one category. %>
<% var qs = search ? '&q=' + encodeURIComponent(search) : ''; %>
<div class="filter-tabs">
  <a href="/admin/products<%= search ? '?q=' + encodeURIComponent(search) : '' %>"
     class="<%= category ? '' : 'active' %>">全部</a>
  <% categories.forEach(function (c) { %>
    <a href="/admin/products?category=<%= c.key %><%= qs %>"
       class="<%= category === c.key ? 'active' : '' %>"><%= c.zh %></a>
  <% }); %>
</div>

<div class="card">
  <form method="get" action="/admin/products" class="search-row" role="search">
    <% if (category) { %><input type="hidden" name="category" value="<%= category %>"><% } %>
    <label class="visually-hidden" for="product-q">搜索产品</label>
    <input id="product-q" name="q" value="<%= search %>"
           placeholder="搜索中英文品名、规格、含量、比例、CAS号、标签或备注">
    <button class="btn" type="submit">搜索</button>
    <% if (search) { %>
      <a class="btn btn-ghost"
         href="/admin/products<%= category ? '?category=' + category : '' %>">清除</a>
    <% } %>
  </form>
  <% if (search) { %>
    <p class="hint search-summary">
      找到 <strong><%= rows.length %></strong> 个匹配「<%= search %>」的产品<%
        %><%= category ? '（仅当前分类，含已下架）' : '（含已下架）' %>。
      <% if (outsideCategory) { %>
        其他分类还有 <strong><%= outsideCategory %></strong> 个匹配 —
        <a href="/admin/products?q=<%= encodeURIComponent(search) %>">在全部分类中搜索</a>。
      <% } %>
    </p>
  <% } %>
</div>

<div class="card">
  <div class="table-wrap">
    <table class="data">
      <thead>
        <tr>
          <th>排序</th>
          <th>图片</th>
          <th>产品英文名字</th>
          <th>中文品名</th>
          <th>分类</th>
          <th>关键字段</th>
          <th>备注</th>
          <th>状态</th>
          <th>操作</th>
        </tr>
      </thead>
      <tbody>
        <% if (!rows.length) { %>
          <tr><td colspan="9" class="empty-row"><%
            if (search) { %>没有匹配「<%= search %>」的产品。换个关键词，或点上方「清除」看全部。<%
            } else { %>暂无产品，点击右上角「新增产品」开始录入。<% } %></td></tr>
        <% } %>
        <% rows.forEach(function (p) { %>
          <% var cat = categories.find(function (c) { return c.key === p.category; }); %>
          <tr>
            <td><%= p.sort_order %></td>
            <td>
              <% if (p.image_path) { %>
                <a class="thumb-link" href="<%= p.image_path %>"
                   data-view="<%= p.image_path %>" data-view-kind="image"
                   data-view-title="<%= p.name_en %>" aria-label="查看大图">
                  <img class="mini-thumb" src="<%= p.image_path %>" alt="" width="46" height="46" loading="lazy">
                </a>
              <% } else { %>—<% } %>
            </td>
            <td><strong><%= p.name_en %></strong></td>
            <%# 内部名称：只在后台出现，前台目录永远不印它。 %>
            <td><%= p.name_zh || '—' %></td>
            <td><%= cat ? cat.zh : p.category %></td>
            <td>
              <%# cat is undefined when a product points at a category that no
                  longer exists. Guarding the name two cells up but not here
                  turned that into a 500 on the whole page — the one page you
                  need in order to fix it. Same guard as import.ejs. %>
              <% if (cat) { cat.fields.forEach(function (f) { %>
                <% if (p[f]) { %>
                  <div><span class="hint"><%= fieldLabels[f].zh %>：</span><%= p[f] %></div>
                <% } %>
              <% }); } else { %>
                <span class="hint">分类「<%= p.category || '（空）' %>」已不存在</span>
              <% } %>
            </td>
            <td><%= p.remark || '—' %></td>
            <td>
              <% if (p.is_active) { %><span class="badge badge-on">上架</span>
              <% } else { %>
                <span class="badge badge-off">下架</span>
                <% if (canPublish) { %><div class="hint">客户看不到</div><% } %>
              <% } %>
            </td>
            <td>
              <div class="row-actions">
                <a class="btn btn-ghost btn-sm" href="/admin/products/<%= p.id %>/edit">编辑</a>
                <% if (canDelete) { %>
                  <form class="inline-form" method="post" action="/admin/products/<%= p.id %>/delete"
                        data-confirm="确定删除产品「<%= p.name_en %>」？此操作不可撤销。">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <button class="btn btn-danger btn-sm" type="submit">删除</button>
                  </form>
                <% } %>
              </div>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
</div>

<%- include('_shell-bottom') %>
