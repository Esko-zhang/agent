<%- include('partials/head', { pageTitle: settings.site_name + ' — Inquiry', lang: 'en' }) %>
<body>
  <%- include('partials/header', { nav: 'inquiry' }) %>

  <main class="wrap">
    <div class="page-head">
      <div class="title-main">
        <p class="eyebrow"><%= settings.brand_name %> · Quotation request</p>
        <h1>Request a Quotation</h1>
      </div>
      <p class="lede">Tell us the quantities you need and our export team will reply with pricing.</p>
      <dl class="title-block">
        <div>
          <dt>Requested by</dt>
          <dd><%= currentUser.display_name || currentUser.username %></dd>
        </div>
        <div>
          <dt>Account</dt>
          <dd><%= currentUser.username %></dd>
        </div>
        <div>
          <dt>Lines</dt>
          <dd><%= rows.length %></dd>
        </div>
        <div>
          <dt>Reply within</dt>
          <dd>1 business day</dd>
        </div>
      </dl>
    </div>

    <% if (error) { %><p class="alert alert-error" role="alert"><%= error %></p><% } %>

    <% if (rep) { %>
      <section class="rep-panel">
        <% if (rep.card && rep.card.photo_path) { %>
          <img class="rep-photo" src="<%= rep.card.photo_path %>" alt="<%= rep.name %>">
        <% } else { %>
          <span class="rep-photo-empty" aria-hidden="true"><%= rep.name.trim().charAt(0).toUpperCase() %></span>
        <% } %>
        <div class="rep-body">
          <p class="rep-label"><%= rep.owned ? 'Your account manager' : 'Sales contact' %></p>
          <h2><%= rep.name %></h2>
          <% if (rep.title) { %><p class="rep-title"><%= rep.title %></p><% } %>
          <% if (rep.card && rep.card.whatsapp) { %>
            <p class="rep-number"><%= rep.card.whatsapp %></p>
          <% } %>
        </div>
        <div class="rep-actions">
          <% if (waInquiry) { %>
            <a class="btn btn-wa" href="<%= waInquiry %>" target="_blank" rel="noopener noreferrer"
               data-wa-inquiry
               data-wa-base="https://wa.me/<%= rep.card.whatsapp.replace(/\D/g, '') %>"
               data-wa-greeting="Hello<%= currentUser.display_name ? ', this is ' + currentUser.display_name : '' %>."
               data-wa-account="<%= currentUser.username %>">
              Send this list on WhatsApp
            </a>
          <% } %>
          <% if (waChat) { %>
            <a class="btn btn-ghost" href="<%= waChat %>" target="_blank" rel="noopener noreferrer">
              Chat on WhatsApp
            </a>
          <% } %>
          <% if (rep.card && rep.card.email) { %>
            <span class="rep-email"><%= rep.card.email %></span>
          <% } %>
        </div>
      </section>
      <% if (waInquiry) { %>
        <p class="rep-note">
          WhatsApp opens with your product list already written out. Prefer email?
          Fill in the form below instead — both reach the same person.
        </p>
      <% } %>
    <% } %>

    <% if (!rows.length) { %>
      <%# A blank sheet, labelled like one: it says what the sheet is for and
          exactly how a line gets onto it, rather than only that it is empty. %>
      <div class="empty-panel">
        <p class="eyebrow">No lines on this sheet</p>
        <p>Add products from the catalogue and they will be listed here with a
          quantity field each. Nothing is sent until you submit the sheet.</p>
        <a class="btn" href="/products">Browse the catalogue</a>
      </div>
    <% } else { %>
      <form method="post" action="/inquiry">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">

        <section class="rfq-section">
          <h2>Products <span class="count"><%= rows.length %></span></h2>
          <div class="table-scroll">
            <table class="products">
              <thead>
                <tr>
                  <th>Product</th>
                  <th>Quantity needed</th>
                  <th>Notes</th>
                  <th class="col-act"></th>
                </tr>
              </thead>
              <tbody>
                <% rows.forEach(function (p) { %>
                  <tr data-rfq-row data-product-name="<%= p.name_en %>">
                    <td class="col-name"><span class="name"><%= p.name_en %></span></td>
                    <td>
                      <input name="qty_<%= p.id %>" value="<%= quantities[p.id] || '' %>"
                             placeholder="e.g. 500 kg" maxlength="60"
                             aria-label="Quantity for <%= p.name_en %>">
                    </td>
                    <td>
                      <input name="note_<%= p.id %>" value="<%= notes[p.id] || '' %>"
                             placeholder="Packaging, spec, target price…" maxlength="300"
                             aria-label="Notes for <%= p.name_en %>">
                    </td>
                    <td class="col-act">
                      <button class="link-danger" type="submit" form="rm-<%= p.id %>">Remove</button>
                    </td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
        </section>

        <section class="rfq-section">
          <h2>Your details</h2>
          <div class="rfq-grid">
            <label class="field">
              <span>Company</span>
              <input name="company" value="<%= form.company %>" maxlength="150">
            </label>
            <label class="field">
              <span>Contact name</span>
              <input name="contact_name" value="<%= form.contact_name %>" maxlength="100">
            </label>
            <label class="field">
              <span>Email *</span>
              <input name="email" type="email" value="<%= form.email %>" required maxlength="150">
            </label>
            <label class="field">
              <span>Phone / WhatsApp</span>
              <input name="phone" value="<%= form.phone %>" maxlength="60">
            </label>
            <label class="field">
              <span>Country / Region</span>
              <input name="country" value="<%= form.country %>" maxlength="80">
            </label>
          </div>
          <label class="field">
            <span>Message</span>
            <textarea name="message" rows="4" maxlength="2000"
                      placeholder="Target price, shipping terms, certifications required…"><%= form.message %></textarea>
          </label>
          <div class="form-actions">
            <button class="btn" type="submit">Send inquiry</button>
            <a class="btn btn-ghost" href="/products">Add more products</a>
          </div>
        </section>
      </form>

      <%# Remove buttons post to their own forms, kept outside the main form. %>
      <% rows.forEach(function (p) { %>
        <form id="rm-<%= p.id %>" method="post" action="/inquiry/remove" class="hidden-form">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <input type="hidden" name="product_id" value="<%= p.id %>">
          <input type="hidden" name="back" value="/inquiry">
        </form>
      <% }); %>

      <form method="post" action="/inquiry/clear" class="clear-form">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button class="link-danger" type="submit">Clear the whole list</button>
      </form>
    <% } %>
  </main>

  <%- include('partials/footer') %>
  <script src="<%= assetUrl('/js/inquiry.js') %>"></script>
</body>
</html>
