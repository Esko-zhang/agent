<%- include('partials/head', { pageTitle: settings.site_name + ' — Sign in', lang: 'en' }) %>
<body class="login-body">
  <main class="login-shell">
    <div class="login-card">
      <aside class="login-aside">
        <div>
          <p class="eyebrow">Private catalogue</p>
          <% if (settings.logo_path) { %>
            <img class="logo-img" src="<%= settings.logo_path %>" alt="<%= settings.brand_name %>">
          <% } else { %>
            <p class="logo-text"><%= settings.brand_name %></p>
          <% } %>
          <p class="tagline"><%= settings.login_tagline %></p>
        </div>
        <div class="login-meta">
          <span class="eyebrow">OEM finished products</span>
          <span class="eyebrow">Plant extracts</span>
          <span class="eyebrow">Food additives</span>
        </div>
      </aside>

      <div class="login-form">
      <p class="eyebrow">Account access</p>
      <h1>Sign in to view the catalogue</h1>

      <% if (error) { %>
        <p class="alert alert-error" role="alert"><%= error %></p>
      <% } %>

      <form method="post" action="/login" autocomplete="on">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="hidden" name="next" value="<%= next %>">

        <label class="field" for="login-user">
          <span>Account</span>
          <input id="login-user" name="username" value="<%= username %>" required
                 autocomplete="username" autocapitalize="none" spellcheck="false" autofocus>
        </label>

        <label class="field" for="login-pass">
          <span>Password</span>
          <input id="login-pass" name="password" type="password" required
                 autocomplete="current-password">
        </label>

        <button class="btn btn-block" type="submit">Sign in</button>
      </form>

      <p class="login-note">
        Accounts are issued by <%= settings.brand_name %> only — there is no public
        registration. Please contact your sales representative to request access.
      </p>
      </div>
    </div>
  </main>
</body>
</html>
