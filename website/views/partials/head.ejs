<!doctype html>
<html lang="<%= typeof lang !== 'undefined' ? lang : 'en' %>">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex, nofollow">
  <meta name="description" content="<%= typeof pageDescription !== 'undefined' && pageDescription
    ? pageDescription
    : 'Private product catalogue issued by ' + settings.brand_name + ' to named customers. Sign-in required.' %>">
  <meta name="color-scheme" content="light">
  <title><%= pageTitle %></title>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="stylesheet" href="<%= assetUrl('/css/site.css') %>">
  <% if (typeof adminCss !== 'undefined' && adminCss) { %>
  <link rel="stylesheet" href="<%= assetUrl('/css/admin.css') %>">
  <% } %>
</head>
