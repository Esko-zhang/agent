<%# The back cover: the same ruled cells as the title block at the top, so a
    reader who scrolls to the bottom lands on something that was designed. %>
<footer class="site-footer">
  <div class="wrap">
    <p class="colophon"><%= settings.brand_name %></p>
    <dl class="foot-grid">
      <div>
        <dt>Issued by</dt>
        <dd><%= settings.footer_text %></dd>
      </div>
      <% if (settings.company_address) { %>
      <div>
        <dt>Address</dt>
        <dd><%= settings.company_address %></dd>
      </div>
      <% } %>
      <div>
        <dt>Distribution</dt>
        <dd class="notice">Private catalogue · not for redistribution</dd>
      </div>
      <div>
        <dt>Access</dt>
        <dd>By issued account only</dd>
      </div>
    </dl>
  </div>
</footer>
