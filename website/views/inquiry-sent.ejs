<%- include('partials/head', { pageTitle: settings.site_name + ' — Inquiry sent', lang: 'en' }) %>
<body>
  <%- include('partials/header', { nav: 'inquiry' }) %>

  <main class="wrap">
    <div class="sent-panel">
      <p class="sent-mark" aria-hidden="true">✓</p>
      <h1>Thank you — your inquiry has been sent</h1>
      <p>
        Your reference number is <strong>#<%= reference %></strong>.
        Our export team will get back to you, normally within one business day.
      </p>
      <% if (rep && waChat) { %>
        <p class="sent-rep">
          Need it faster? Message <strong><%= rep.name %></strong> directly.
        </p>
      <% } %>
      <div class="form-actions">
        <% if (waChat) { %>
          <a class="btn btn-wa" href="<%= waChat %>" target="_blank" rel="noopener noreferrer">
            Chat on WhatsApp
          </a>
        <% } %>
        <a class="btn <%= waChat ? 'btn-ghost' : '' %>" href="/products">Back to the catalogue</a>
        <a class="btn btn-ghost" href="/contact">Contact a sales representative</a>
      </div>
    </div>
  </main>

  <%- include('partials/footer') %>
</body>
</html>
