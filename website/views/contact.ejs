<%- include('partials/head', { pageTitle: settings.site_name + ' — Contact Us', lang: 'en' }) %>
<body>
  <%- include('partials/header', { nav: 'contact' }) %>

  <main class="wrap">
    <div class="page-head">
      <div class="title-main">
        <p class="eyebrow"><%= settings.brand_name %> · Export team</p>
        <h1>Contact Us</h1>
      </div>
      <p class="lede"><%= settings.contact_intro %></p>
      <dl class="title-block">
        <div>
          <dt>Signed in as</dt>
          <dd><%= currentUser.display_name || currentUser.username %></dd>
        </div>
        <div>
          <dt>Account</dt>
          <dd><%= currentUser.username %></dd>
        </div>
        <div>
          <dt>Contacts</dt>
          <dd><%= team.length %></dd>
        </div>
        <div>
          <dt>Reply within</dt>
          <dd>1 business day</dd>
        </div>
      </dl>
    </div>

    <% if (!team.length) { %>
      <p class="alert alert-ok">No sales contacts have been published yet.</p>
    <% } %>

    <div class="staff-grid">
      <% team.forEach(function (m) { %>
        <article class="staff-card">
          <% if (m.photo_path) { %>
            <a class="thumb-link" href="<%= m.photo_path %>"
               data-view="<%= m.photo_path %>" data-view-kind="image"
               data-view-title="<%= m.name %><%= m.title ? ' · ' + m.title : '' %>"
               aria-label="View photo of <%= m.name %>">
              <img class="staff-photo" src="<%= m.photo_path %>" alt="<%= m.name %>"
                   width="72" height="72" loading="lazy">
            </a>
          <% } else { %>
            <span class="staff-photo-empty" aria-hidden="true"><%= m.name.trim().charAt(0).toUpperCase() %></span>
          <% } %>
          <div class="staff-body">
            <h3><%= m.name %></h3>
            <p class="role"><%= m.title || 'Sales Representative' %></p>
            <ul class="staff-contact">
              <% if (m.phone) { %>
                <li><span class="label">Tel</span>
                  <a href="tel:<%= m.phone.replace(/[^+\d]/g, '') %>"><%= m.phone %></a></li>
              <% } %>
              <% if (m.whatsapp) { %>
                <li><span class="label">WhatsApp</span>
                  <% var wa = waLink(m.whatsapp); %>
                  <% if (wa) { %>
                    <a href="<%= wa %>" target="_blank" rel="noopener noreferrer"><%= m.whatsapp %></a>
                  <% } else { %>
                    <span><%= m.whatsapp %></span>
                  <% } %>
                </li>
              <% } %>
              <% if (m.email) { %>
                <li><span class="label">Email</span>
                  <a href="mailto:<%= m.email %>"><%= m.email %></a></li>
              <% } %>
            </ul>
          </div>
        </article>
      <% }); %>
    </div>
  </main>

  <%- include('partials/footer') %>

  <script src="<%= assetUrl('/js/viewer.js') %>"></script>
</body>
</html>
