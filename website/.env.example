# ---- Required in production -------------------------------------------------
NODE_ENV=production

# Signs the session cookie. MUST be changed, at least 32 chars.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string

# ---- Initial admin account (used by `npm run init-db`) ----------------------
ADMIN_USERNAME=admin
# Leave empty to have a strong password generated and printed once.
ADMIN_PASSWORD=

# ---- Server ----------------------------------------------------------------
PORT=3000
HOST=0.0.0.0
# How many proxies sit in front of this app. This decides which IP the access
# log records, so it must match your deployment:
#   0            no proxy (direct)
#   1            one reverse proxy, e.g. Nginx or Caddy
#   2            a CDN (Cloudflare) in front of Nginx
#   loopback, an IP, a CIDR, or a comma-separated list of them
# Too low and every visitor is logged as the proxy; too high and a visitor can
# forge their own IP with an X-Forwarded-For header.
TRUST_PROXY=0
# Send session cookies over HTTPS only. Defaults to on when NODE_ENV=production.
COOKIE_SECURE=1

# ---- Storage ---------------------------------------------------------------
# DB_FILE=./data/site.db
# UPLOAD_DIR=./public/uploads
MAX_UPLOAD_MB=5

# ---- Sessions & login throttling -------------------------------------------
SESSION_TTL_HOURS=12
LOGIN_MAX_ATTEMPTS=8
LOGIN_WINDOW_MINUTES=15
