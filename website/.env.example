# ---- Required in production -------------------------------------------------
NODE_ENV=production

# Signs the session cookie. MUST be changed, at least 32 chars.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string

# ---- Initial admin account (used by `npm run init-db`) ----------------------
ADMIN_USERNAME=admin
# Leave empty to have a strong password generated and printed once.
ADMIN_PASSWORD=

# ---- Server ----------------------------------------------------------------
PORT=3000
HOST=0.0.0.0
# How many proxies sit in front of this app. This decides which IP the access
# log records, so it must match your deployment:
#   0            no proxy (direct)
#   1            one reverse proxy, e.g. Nginx or Caddy
#   2            a CDN (Cloudflare) in front of Nginx
#   loopback, an IP, a CIDR, or a comma-separated list of them
# Too low and every visitor is logged as the proxy; too high and a visitor can
# forge their own IP with an X-Forwarded-For header.
TRUST_PROXY=0
# Send session cookies over HTTPS only. Defaults to on when NODE_ENV=production.
COOKIE_SECURE=1

# ---- Storage ---------------------------------------------------------------
# DB_FILE=./data/site.db
# UPLOAD_DIR=./public/uploads        product images (served publicly by filename)
# DOC_DIR=./data/docs                spec sheets (served only to signed-in users)
MAX_UPLOAD_MB=5
MAX_DOC_MB=20

# ---- Inquiry email notifications (optional) ---------------------------------
# Leave SMTP_HOST empty to turn email off: inquiries are still saved and shown
# in the backend, they just do not trigger a mail.
#
# Pre-filled for 阿里云企业邮箱 (Alibaba Cloud enterprise mail). Three things
# have to be true on their side first, or authentication fails:
#   1. the administrator has enabled SMTP / third-party clients for the
#      account — newer tenants have them off by default;
#   2. SMTP_PASS is the 三方客户端安全密码 generated in 邮箱设置 → 账户安全,
#      not the password used to sign in to the web mail;
#   3. SMTP_FROM is the same address as SMTP_USER (a display name is fine) —
#      sending as a different address is rejected.
# Port 465 with SSL is used rather than 25, which Alibaba Cloud blocks
# outbound on ECS instances. Run `npm run mail-test` to check all of this.
SMTP_HOST=smtp.qiye.aliyun.com
SMTP_PORT=465
SMTP_SECURE=1
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Extra recipients beyond the active sales reps' own addresses, comma separated.
INQUIRY_NOTIFY_TO=

# ---- Sessions & login throttling -------------------------------------------
SESSION_TTL_HOURS=12
LOGIN_MAX_ATTEMPTS=8
LOGIN_WINDOW_MINUTES=15
