# ---- Required in production -------------------------------------------------
NODE_ENV=production

# Signs the session cookie. MUST be changed, at least 32 chars.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string

# ---- Initial admin account (used by `npm run init-db`) ----------------------
ADMIN_USERNAME=admin
# Leave empty to have a strong password generated and printed once.
ADMIN_PASSWORD=

# ---- Server ----------------------------------------------------------------
PORT=3000
HOST=0.0.0.0
# Set to 1 when running behind Nginx/Caddy so client IPs and HTTPS are detected.
TRUST_PROXY=0
# Send session cookies over HTTPS only. Defaults to on when NODE_ENV=production.
COOKIE_SECURE=1

# ---- Storage ---------------------------------------------------------------
# DB_FILE=./data/site.db
# UPLOAD_DIR=./public/uploads
MAX_UPLOAD_MB=5

# ---- Sessions & login throttling -------------------------------------------
SESSION_TTL_HOURS=12
LOGIN_MAX_ATTEMPTS=8
LOGIN_WINDOW_MINUTES=15
